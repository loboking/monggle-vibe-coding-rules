
# Vibe Coding Rules
logs/*.log

# Override global .gitignore for .claude commands
!.claude/commands/
!.claude/hooks/
!.claude/lib/
!.claude/config/
!.claude/brain/
!.claude/skills/
!.claude/skills/**
!.claude/agents/
!.claude/agents/**
!.claude/agents-team/
!.claude/agents-team/**

# Python
__pycache__/
*.pyc
*.pyo
.gstack/
# Logs
logs/*.log
logs/*.json

# Pipeline — 런타임 산출물은 무시, 정본 문서는 추적 유지
.harness/
!.harness/HARNESS_ANALYSIS.md
!.harness/HARNESS_COMPLETED.md
!.harness/on-the-loop.md

# Agents (런타임 산출물은 무시하되, 파이프라인 핵심 모듈은 추적)
agents/*
!agents/base_agent.py

# Session & local config (global gitignore에만 의존하지 않도록 프로젝트에서도 명시)
.claude/settings.local.json
.claude/.prd-session.json
.claude/session/
.claude/skills/brain-web/data.json
monggle.config.yaml

{
  "name": "monggle-vibe-coding-rules",
  "version": "3.1.0",
  "description": "Vibe Coding Rules for Claude Code",
  "language": "ko",
  "created": "2026-06-16T08:27:33Z",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/brain-session-start.sh", "timeout": 10 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/brain-prompt-recall.sh", "timeout": 15 }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/brain-turn-save.sh", "timeout": 15 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/brain-session-end.sh", "timeout": 30 }
        ]
      }
    ]
  }
}
